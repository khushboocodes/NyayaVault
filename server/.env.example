PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=24h
MASTER_ENCRYPTION_KEY=your_64_char_hex_master_encryption_key_here
STORAGE_DIR=./storage/vault
DATABASE_PATH=./storage/nyayavault.sqlite
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
RELAYER_PRIVATE_KEY=your_ethereum_relayer_private_key_here

# Cloud Database (Turso LibSQL - 9 GB Lifetime Free, No Credit Card)
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your_turso_jwt_auth_token

# Cloud Vault Storage (Supabase Storage - 1 GB Lifetime Free, No Credit Card)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=nyayavault-vault

